{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "broadening-circles-sync",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-20",
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALLOWED_ORIGIN": "https://floydstott.github.io"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "broadening-circles",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
