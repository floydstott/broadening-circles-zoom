{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "broadening-circles-sync",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-20",
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALLOWED_ORIGIN": "https://floydstott.github.io"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "broadening-circles",
      "database_id": "8c9d21fd-a43f-4e45-b435-c947a7ae7717",
      "migrations_dir": "migrations"
    }
  ]
}
